@model LoginViewModel
@{
    ViewData["Title"] = "登录";
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>登录 - ADMIN-UI-PRO</title>
    <link href="/lib/layui-admin/layui/css/layui.css" rel="stylesheet">
    <link href="/lib/layui-admin/admin-ui/css/login.css" rel="stylesheet">
</head>
<body class="layui-layout-body">
    <div class="layadmin-user-login layadmin-user-display-show" id="LAY-user-login">
        <div class="layadmin-user-login-main">
            <div class="layadmin-user-login-box layadmin-user-login-header">
                <h2>ADMIN-UI-PRO</h2>
                <p>后台管理系统</p>
            </div>
            <div class="layadmin-user-login-box layadmin-user-login-body layui-form">
                <!-- 租户（预留控件：功能暂未启用） -->
                <div class="layui-form-item">
                    <label class="layadmin-user-login-icon layui-icon layui-icon-group" for="LAY-user-login-tenant"></label>
                    <input type="text" name="Tenant" id="LAY-user-login-tenant" placeholder="租户名称（可选）" autocomplete="organization" class="layui-input" value="@Model.Tenant">
                </div>
                <div class="layui-form-item">
                    <label class="layadmin-user-login-icon layui-icon layui-icon-username" for="LAY-user-login-username"></label>
                    <input type="text" name="UserNameOrEmailAddress" id="LAY-user-login-username" lay-verify="required" placeholder="用户名 / 邮箱" class="layui-input" value="@Model.UserNameOrEmailAddress">
                </div>
                <div class="layui-form-item">
                    <label class="layadmin-user-login-icon layui-icon layui-icon-password" for="LAY-user-login-password"></label>
                    <input type="password" name="Password" id="LAY-user-login-password" lay-verify="required" placeholder="密码" class="layui-input">
                </div>
                <!-- 语言（预留控件：简体中文 / 繁體中文 / English，功能暂未启用） -->
                <div class="layui-form-item" style="margin-bottom:20px;">
                    <select name="Language" id="LAY-user-login-language" lay-filter="LAY-user-login-language">
                        <option value="zh-Hans" selected>简体中文</option>
                        <option value="zh-Hant">繁體中文</option>
                        <option value="en">English</option>
                    </select>
                </div>
                <div class="layui-form-item" style="margin-bottom:20px;">
                    <input type="checkbox" name="RememberMe" value="true" lay-skin="primary" title="记住我">
                    <div class="layui-input-inline layadmin-user-jump-change">
                        <a href="javascript:;">忘记密码？</a>
                    </div>
                </div>
                <div class="layui-form-item">
                    <button class="layui-btn layui-btn-fluid" lay-submit lay-filter="LAY-user-login-submit">登 录</button>
                </div>
            </div>
        </div>
        <div class="layadmin-user-login-footer">
            <p>© 2026 ADMIN-UI-PRO</p>
        </div>
    </div>

    <script src="/lib/layui-admin/layui/layui.js"></script>
    <script>
        layui.use(['form', 'layer'], function () {
            var form = layui.form;
            var layer = layui.layer;
            var $ = layui.jquery;

            form.on('submit(LAY-user-login-submit)', function (obj) {
                var loading = layer.load(1);
                $.ajax({
                    url: '@Url.Action("Login", "Account")',
                    type: 'POST',
                    data: obj.field,
                    dataType: 'json',
                    success: function (res) {
                        layer.close(loading);
                        if (res && res.success) {
                            location.href = '/';
                        } else {
                            layer.msg(res && res.message ? res.message : '登录失败', { icon: 2 });
                        }
                    },
                    error: function () {
                        layer.close(loading);
                        layer.msg('网络异常，请稍后重试', { icon: 2 });
                    }
                });
                return false;
            });
        });
    </script>
</body>
</html>
