<UserControl
    x:Class="Admin.Desktop.View.Quartzs.QuartzView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Admin.Desktop.View.Quartzs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:Admin.Desktop.UserControls"
    xmlns:viewmodel="clr-namespace:Admin.Desktop.ViewModel.Quartzs"
    d:DataContext="{d:DesignInstance Type=viewmodel:QuartzVM}"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    hc:Dialog.Token="{Binding MainDialogContainerToken}"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Expander
                Grid.Row="0"
                Header="搜索条件"
                IsExpanded="True">
                <Border
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,4,4">
                    <hc:UniformSpacingPanel
                        Margin="5"
                        VerticalAlignment="Center"
                        ChildWrapping="Wrap"
                        Spacing="5">
                        <hc:TextBox
                            MinWidth="200"
                            hc:InfoElement.Placeholder="请输入名称"
                            hc:InfoElement.ShowClearButton="True"
                            hc:InfoElement.Title="名称"
                            hc:InfoElement.TitlePlacement="Left"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                            Command="{Binding SearchCommand}"
                            Content="搜索"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            hc:IconElement.Geometry="{StaticResource RotateLeftGeometry}"
                            Command="{Binding ResetCommand}"
                            Content="重置" />
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
            <ToolBar
                Grid.Row="1"
                Margin="0,2"
                Padding="0,5"
                HorizontalAlignment="Right">
                <hc:UniformSpacingPanel Spacing="5">
                    <Button
                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                        Command="{Binding AddJobCommand}"
                        Content="新增"
                        Style="{StaticResource ButtonDefault}"
                        Visibility="{Binding BtnPerms[MainCreate]}" />
                    <Button
                        hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                        Command="{Binding BatchDeleteJobCommand}"
                        CommandParameter="{Binding ElementName=DG, Path=SelectedItems}"
                        Content="批量删除"
                        Style="{StaticResource ButtonDanger}"
                        Visibility="{Binding BtnPerms[MainDelete]}" />
                </hc:UniformSpacingPanel>
            </ToolBar>
            <hc:DialogContainer Grid.Row="2">
                <DockPanel>
                    <uc:PaginationPlus
                        Margin="1"
                        DataCountPerPage="{Binding MainDataCountPerPage}"
                        DockPanel.Dock="Bottom"
                        PageUpdatedCommand="{Binding MainPageChangedCommand}"
                        TotalCount="{Binding MainTotalCount}"
                        PageIndex="{Binding MainPageIndex}" />
                    <DataGrid
                        Name="DG"
                        hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
                        AutoGenerateColumns="False"
                        HeadersVisibility="All"
                        IsReadOnly="True"
                        ItemsSource="{Binding QrtzJobs}"
                        RowHeaderWidth="60"
                        Style="{StaticResource DataGrid.Small}">
                        <DataGrid.RowHeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                            </DataTemplate>
                        </DataGrid.RowHeaderTemplate>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Binding="{Binding Id}"
                                Header="Id"
                                Visibility="Hidden" />
                            <DataGridTextColumn Binding="{Binding JobName}" Header="名称" />
                            <DataGridTextColumn Binding="{Binding JobGroup}" Header="组名" />
                            <DataGridCheckBoxColumn Binding="{Binding IsDisallowConcurrent}" Header="是否允许并发" />
                            <DataGridCheckBoxColumn Binding="{Binding IsEnabled}" Header="是否启用" />
                            <DataGridTextColumn Binding="{Binding Description}" Header="描述" />
                            <DataGridTextColumn Binding="{Binding CreationTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" Header="创建时间" />
                            <DataGridTextColumn Binding="{Binding LastModificationTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" Header="修改时间" />
                            <DataGridTemplateColumn Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:UniformSpacingPanel Spacing="5">
                                            <Button
                                                hc:IconElement.Geometry="{StaticResource DropperGeometry}"
                                                Command="{Binding DataContext.EditJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="编辑"
                                                Style="{StaticResource ButtonDefault.Small}"
                                                Visibility="{Binding Path=DataContext.BtnPerms[MainEdit], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />

                                            <Button
                                                hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                                Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="删除"
                                                Style="{StaticResource ButtonDanger.Small}"
                                                Visibility="{Binding Path=DataContext.BtnPerms[MainDelete], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                        </hc:UniformSpacingPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </hc:DialogContainer>
        </Grid>

        <GridSplitter
            Grid.Row="1"
            Height="5"
            Margin="0,2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid x:Name="PART_Grip">
                        <Rectangle Fill="{DynamicResource RegionBrush}" />
                        <!--  视觉细线条，垂直居中；修改Height调整粗细  -->
                        <Rectangle
                            x:Name="VisualLine"
                            Height="2"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource RegionBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="VisualLine" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <TabControl Grid.Row="2">
            <TabItem Header="触发器">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ToolBar
                        Grid.Row="1"
                        Margin="0,2"
                        Padding="0,5"
                        HorizontalAlignment="Right">
                        <hc:UniformSpacingPanel Spacing="5">
                            <Button
                                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                Command="{Binding AddTriggerCommand}"
                                Content="新增"
                                Style="{StaticResource ButtonDefault}"
                                Visibility="{Binding BtnPerms[DetailCreate]}" />
                            <Button
                                hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                Command="{Binding BatchDeleteTriggerCommand}"
                                CommandParameter="{Binding ElementName=DG, Path=SelectedItems}"
                                Content="批量删除"
                                Style="{StaticResource ButtonDanger}"
                                Visibility="{Binding BtnPerms[DetailDelete]}" />
                        </hc:UniformSpacingPanel>
                    </ToolBar>
                    <Border Grid.Row="2" hc:Dialog.Token="{Binding DetailDialogContainerToken}">
                        <hc:DialogContainer>
                            <DockPanel>
                                <uc:PaginationPlus
                                    Margin="1"
                                    DataCountPerPage="{Binding DetailDataCountPerPage}"
                                    DockPanel.Dock="Bottom"
                                    PageUpdatedCommand="{Binding DetailPageChangedCommand}"
                                    TotalCount="{Binding DetailTotalCount}"
                                    PageIndex="{Binding DetailPageIndex}" />
                                <DataGrid
                                    Name="DG_Detail"
                                    hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
                                    AutoGenerateColumns="False"
                                    HeadersVisibility="All"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding QrtzTriggers}"
                                    RowHeaderWidth="60"
                                    Style="{StaticResource DataGrid.Small}">
                                    <DataGrid.RowHeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                        </DataTemplate>
                                    </DataGrid.RowHeaderTemplate>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Binding="{Binding Id}"
                                            Header="Id"
                                            Visibility="Hidden" />
                                        <DataGridTextColumn Binding="{Binding TriggerName}" Header="触发器名称" />
                                        <DataGridTextColumn Binding="{Binding TriggerGroup}" Header="触发器组名" />
                                        <DataGridTextColumn Binding="{Binding TriggerType}" Header="类型" />
                                        <DataGridTextColumn Binding="{Binding Priority}" Header="优先级" />
                                        <DataGridCheckBoxColumn Binding="{Binding IsEnabled}" Header="是否启用" />
                                        <DataGridTextColumn Binding="{Binding Description}" Header="描述" />
                                        <DataGridTextColumn Binding="{Binding CreationTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" Header="创建时间" />
                                        <DataGridTextColumn Binding="{Binding LastModificationTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" Header="修改时间" />
                                        <DataGridTemplateColumn Header="操作">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <hc:UniformSpacingPanel Spacing="5">
                                                        <Button
                                                            hc:IconElement.Geometry="{StaticResource DropperGeometry}"
                                                            Command="{Binding DataContext.EditTriggerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Content="编辑"
                                                            Style="{StaticResource ButtonDefault.Small}"
                                                            Visibility="{Binding Path=DataContext.BtnPerms[DetailEdit], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                                        <Button
                                                            hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                                            Command="{Binding DataContext.DeleteTriggerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Content="删除"
                                                            Style="{StaticResource ButtonDanger.Small}"
                                                            Visibility="{Binding Path=DataContext.BtnPerms[DetailDelete], RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                                    </hc:UniformSpacingPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </hc:DialogContainer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
